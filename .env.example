# Charter — environment variables
#
#   cp .env.example .env      then fill in .env with your real values.
#
# .env is never committed. This file lists the NAME of every credential the
# project needs, what it is for, and where to get it. Nothing else.
#
# ─────────────────────────────────────────────────────────────────────────────
# YOU PROBABLY DO NOT NEED ANY OF THESE
# ─────────────────────────────────────────────────────────────────────────────
# With REPLAY_MODE=true — the default — Charter serves saved vendor responses
# instead of calling out, and the whole flow runs end to end with no accounts and
# no keys at all. That is the intended way to evaluate this project.
#
# Fill these in only if you want to make real calls.

# true  = serve saved responses. No network, no credentials, costs nothing.
# false = call the real services. Consumes limited free allowances.
REPLAY_MODE=true

# test = the registrar's free sandbox. Nothing real is registered, no money.
# live = real registrations that cost real money. This project ships as "test".
REGISTRAR_ENV=test

# light = cheaper document reading, for development. thorough = full accuracy.
EXTRACTION_DEPTH=light

# ─────────────────────────────────────────────────────────────────────────────
# THE MODELS
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini — the main model.  aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — the fallback, and the only provider allowed to receive a person's
# details, because it keeps nothing and does not train on what it is sent.
#   console.groq.com/keys
GROQ_API_KEY=

# The most a single request to a model may be, in tokens. Checked before
# sending, so an oversized request fails here rather than at the provider.
MODEL_MAX_REQUEST_TOKENS=4000

# How many model turns one stage may take, so a failing tool cannot loop forever.
MAX_TURNS_PER_STAGE=12

# ─────────────────────────────────────────────────────────────────────────────
# DOCTAVIAN — writes the ownership agreement from one adaptive template
# ─────────────────────────────────────────────────────────────────────────────
# doctavian.com — access is granted per account.
DOCTAVIAN_BASE_URL=
DOCTAVIAN_API_KEY=
DOCTAVIAN_AUTH_PROVIDER=
DOCTAVIAN_REFRESH_TOKEN=
DOCTAVIAN_OAUTH_CLIENT_ID=
DOCTAVIAN_OAUTH_SCOPE=

# ─────────────────────────────────────────────────────────────────────────────
# FOXIT — assembles the pack, and separately carries it to a human to sign
# ─────────────────────────────────────────────────────────────────────────────
# app.developer-api.foxit.com
#
# Foxit issues ONE credential pair that authenticates all of their services, so
# the two pairs below hold the same values. That is correct and expected —
# their own guide states there is no separate signing key pair to generate.
#
# The separation that matters in Charter is therefore not in these values. It is
# in the code: no tool the model can call is able to reach the signing module,
# and a test walks the import graph and fails the build if that ever changes.
FOXIT_PDF_BASE_URL=
FOXIT_PDF_CLIENT_ID=
FOXIT_PDF_CLIENT_SECRET=
FOXIT_ESIGN_BASE_URL=
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# NUTRIENT — reads the owners' identity documents and scores each field
# ─────────────────────────────────────────────────────────────────────────────
# nutrient.io
#
# TWO keys, not one. Reading fields out of a document is a separate product from
# the general document processor, with its own key and its own account. Using the
# processor key against the extraction service is refused outright.
NUTRIENT_PROCESSOR_KEY=
NUTRIENT_EXTRACTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NAME.COM — checks and registers the web address
# ─────────────────────────────────────────────────────────────────────────────
# name.com/account/settings/api
#
# The sandbox is a separate account whose username ends in -test. Getting this
# wrong in one direction attempts a real, paid registration.
NAMECOM_USERNAME=
NAMECOM_TOKEN_TEST=
NAMECOM_BASE_URL_TEST=
NAMECOM_TOKEN_LIVE=

# ─────────────────────────────────────────────────────────────────────────────
# SEARCH — live research on whether the business name is already taken
# ─────────────────────────────────────────────────────────────────────────────
# serpapi.com, and tavily.com as the fallback behind the same internal tool.
SERPAPI_KEY=
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PERFECT CORP — draws the new business's first storefront picture
# ─────────────────────────────────────────────────────────────────────────────
# Redeem a key at yce.perfectcorp.com/api-console/en/redeem-code/
#
# Used only to turn the owner's own description of their business into imagery
# for the website Charter publishes. Nothing is uploaded and no photograph is
# ever sent. Their face and skin tools are not used and are absent from every
# tool list. Optional — leave blank and the site publishes without imagery.
PERFECTCORP_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE AND HOSTING
# ─────────────────────────────────────────────────────────────────────────────

# Leave blank to use the PostgreSQL engine that runs inside this project. Set it
# only to point at a hosted database instead.
DATABASE_URL=

# vercel = the storage included with a Vercel account.  s3 = anything
# S3-compatible, configured below.
STORAGE_DRIVER=vercel
BLOB_READ_WRITE_TOKEN=

# Only if STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Where the generated business websites are published.
# vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
PUBLISH_DOMAIN_SUFFIX=

# ─────────────────────────────────────────────────────────────────────────────
# THE ATTESTATION KEY
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: npm run keys:generate
#
# This signs the head of Charter's record. The PUBLIC half is committed to the
# repository at keys/attestation.pub on purpose, so anyone can check our record
# without asking us for anything. The PRIVATE half belongs here and nowhere else.
#
# It is an ATTESTATION — the system vouching for its own conduct. It is not a
# signature. In Charter that word is reserved for something a person does.
ATTESTATION_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# NOTHING BELOW IS A SECRET
# ─────────────────────────────────────────────────────────────────────────────

# When a field read from an identity document goes to a person.
#
# The FIRST test is not this number. It is whether the value could be found in the
# document at all - the reading service says so per field, and anything it could
# not ground, matched only approximately, or matched only in part goes to a person
# whatever this number says.
#
# This floor is the last test, not the first, because the service states plainly
# that its confidence score "is relative and uncalibrated; it isn't a probability
# or percentage." A number below is calibrated against our own sample rather than
# picked, and the sample is recorded.
#
# The system may send MORE to a person than these rules require. It can never send
# fewer, and no model takes part in the decision.
REVIEW_CONFIDENCE_FLOOR=0.85

# A fraction of confident readings are sent to a human anyway, to catch a service
# that is confidently wrong.
REVIEW_AUDIT_SAMPLE_RATE=0.1
