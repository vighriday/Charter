{
  "name": "charter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prepares everything around a business formation, and keeps a record of it that anyone can check.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "git:check": "node scripts/git-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:generate": "tsx src/record/generate-keys.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "record:demo": "tsx src/record/demo.ts",
    "check": "npm run git:check && npm run words:check && npm run typecheck && npm run test && npm run catalogue:check && npm run readme:check && npm run settings:check && npm run site:check",
    "start": "tsx src/case/live.ts",
    "agent:demo": "tsx src/case/demo.ts",
    "keys:classify": "tsx src/checks/classify.ts",
    "readme:check": "node scripts/check-readme-counts.mjs",
    "words:check": "node scripts/check-words.mjs",
    "settings": "node scripts/settings.mjs",
    "site:data": "node scripts/site-data.mjs --fresh",
    "settings:check": "node scripts/settings.mjs --check",
    "catalogue": "node scripts/catalogue.mjs",
    "catalogue:check": "node scripts/catalogue.mjs --check",
    "verify": "tsx src/verify/cli.ts",
    "site:check": "node scripts/check-site.mjs",
    "fonts": "node scripts/fonts.mjs",
    "serve": "tsx src/serve/server.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "canonicalize": "^2.0.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "zgapdfsigner": "^2.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
